<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PruebaTecnicaBack</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- FluentValidation -->
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

        <!-- Password Hashing -->
        <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />

        <!-- Entity Framework Core & SQLite -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="EntityFrameworkCore.Exceptions.Sqlite" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- OpenAPI & Scalar UI -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="sample-data\bulk_users_test.json" />
    </ItemGroup>

</Project>
